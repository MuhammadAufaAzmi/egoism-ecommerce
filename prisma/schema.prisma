datasource db {
  provider  = "postgresql"
  url       = env("SUPABASE_URL")
  directUrl = env("SUPABASE_DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// 1. USER
// ==========================================
model User {
  id               String    @id @default(uuid())
  email            String    @unique
  password         String?
  firstName        String?
  lastName         String?
  phone            String?
  role             String    @default("USER")
  resetToken       String?
  resetTokenExpiry DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  carts     Cart[]
  addresses Address[]
  orders    Order[]
  wishlists Wishlist[]
  reviews   Review[]
}

// ==========================================
// 2. PRODUCT
// ==========================================
model Product {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  price       Int
  category    String
  image       String
  images      String   @default("[]") // JSON string array untuk galeri
  description String   @db.Text
  sizes       String   // JSON string array, contoh: ["S","M","L","XL"]
  colors      String   @default("[]") // JSON string array, contoh: ["BLACK","WHITE"]
  fitType     String   @default("[\"regular\"]") // JSON string array, contoh: ["regular", "oversized"]
  activity    String   @default("[]") // JSON string array, contoh: ["gym","crossfit","running"]
  isNew       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  carts       Cart[]
  wishlists   Wishlist[]
  reviews     Review[]
}

// ==========================================
// 3. CART
// ==========================================
model Cart {
  id        String   @id @default(uuid())
  userId    String
  productId String
  size      String
  color     String   @default("BLACK")
  fitType   String   @default("regular")
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId, size, color, fitType])
}

// ==========================================
// 4. ADDRESS
// ==========================================
model Address {
  id         String   @id @default(uuid())
  userId     String
  label      String
  recipient  String
  phone      String
  address    String
  city       String
  province   String
  postal     String
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ==========================================
// 5. ORDER
// ==========================================
model Order {
  id              String   @id @default(uuid())
  orderNumber     String   @unique
  userId          String
  items           String   @db.Text
  total           Int
  shippingCost    Int      @default(0)
  shippingZone    String?
  trackingNumber  String?
  status          String   @default("DIPROSES")
  paymentProof    String?  @db.VarChar(255)
  shippingAddress String?  @db.Text
  createdAt       DateTime @default(now())

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ==========================================
// 6. WISHLIST
// ==========================================
model Wishlist {
  id        String   @id @default(uuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

// ==========================================
// 7. REVIEW
// ==========================================
model Review {
  id        String   @id @default(uuid())
  userId    String
  productId String
  rating    Int      // 1-5
  comment   String?  @db.Text
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

// ==========================================
// 6. SHIPPING ZONE
// ==========================================
model ShippingZone {
  id        String @id @default(uuid())
  zone      String   // JABODETABEK, JAWA, SUMATERA, dll
  province  String @unique
  cost      Int      // Dalam Rupiah
  etd       String   // Contoh: "1-2 hari"
}

// ==========================================
// 8. PROMO CODE / VOUCHER
// ==========================================
model PromoCode {
  id            String   @id @default(uuid())
  code          String   @unique
  discountType  String   // "percent" | "fixed"
  discountValue Int      // Persen (10) atau nominal (50000)
  minOrder      Int      @default(0)
  maxUses       Int      @default(0) // 0 = unlimited
  usedCount     Int      @default(0)
  expiresAt     DateTime?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
}